# Dependencies only. dist/ is deliberately COMMITTED: the skill copy must run the moment it is
# installed (npx skills add); the build output is therefore treated as shipped source, not as
# a disposable artifact. Regenerate with `npm run build`.
node_modules/

# Design documents and process artifacts — not part of the published source.
# The design docs live outside this repository; see README.md.
documents/
outputs/
res/

# Process files: local working conventions, not product source
AGENTS.MD
.agents/
.gemini/

# Generated visualisations from ad-hoc tooling
*.html

# Credentials must never enter the repository
*.env
credentials*.env
.env*

# Local noise
*.log
*.tmp

# Publish artifacts
*.tgz

# Runtime state written inside the skill directory
data/
